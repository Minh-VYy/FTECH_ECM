@{
    Layout = null;
    var html = System.IO.File.ReadAllText(Server.MapPath("~/Views/manage-affiliates.html"));
    html = html.Replace("href=\"assets/css/pages/manage-affiliates.css\"", "href=\"" +
Url.Content("~/Content/css/pages/manage-affiliates.css") + "\"");
    html = html.Replace("href=\"assets/css/common/inline-utilities.css\"", "href=\"" +
Url.Content("~/Content/css/common/inline-utilities.css") + "\"");
    html = html.Replace("href=\"assets/css/common/admin-shell.css\"", "href=\"" +
Url.Content("~/Content/css/common/admin-shell.css") + "\"");
    html = html.Replace("src=\"assets/js/common/auth.js\"", "src=\"" + Url.Content("~/Scripts/js/common/auth.js") + "\"");
    html = html.Replace("src=\"assets/js/pages/manage-affiliates.js\"", "src=\"" +
Url.Content("~/Scripts/js/pages/manage-affiliates.js") + "\"");
    html = html.Replace("product.html", Url.Action("Index", "Product"));
    html = html.Replace("manage-affiliates.html", Url.Action("Index", "Affiliate", new { area = "AffiliateManager" }));
}
@Html.Raw(html)
