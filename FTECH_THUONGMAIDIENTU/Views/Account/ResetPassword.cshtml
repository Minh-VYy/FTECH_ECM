@{
    Layout = null;
    var html = System.IO.File.ReadAllText(Server.MapPath("~/Views/reset-password.html"));
    html = html.Replace("href=\"assets/css/pages/reset-password.css\"", "href=\"" +
Url.Content("~/Content/css/pages/reset-password.css") + "\"");
    html = html.Replace("href=\"assets/css/common/inline-utilities.css\"", "href=\"" +
Url.Content("~/Content/css/common/inline-utilities.css") + "\"");
    html = html.Replace("src=\"assets/js/pages/reset-password.js\"", "src=\"" +
Url.Content("~/Scripts/js/pages/reset-password.js") + "\"");
    html = html.Replace("trangchu.html", Url.Action("Index", "Home"));
    html = html.Replace("login.html", Url.Action("Login", "Account"));
}
@Html.Raw(html)
