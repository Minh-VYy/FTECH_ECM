@{
    Layout = null;
    var html = System.IO.File.ReadAllText(Server.MapPath("~/Views/login.html"));
    html = html.Replace("href=\"assets/css/pages/login.css\"", "href=\"" + Url.Content("~/Content/css/pages/login.css") +
"\"");
    html = html.Replace("href=\"assets/css/common/inline-utilities.css\"", "href=\"" +
Url.Content("~/Content/css/common/inline-utilities.css") + "\"");
    html = html.Replace("src=\"assets/js/pages/login.js\"", "src=\"" + Url.Content("~/Scripts/js/pages/login.js") + "\"");
    html = html.Replace("trangchu.html", Url.Action("Index", "Home"));
    html = html.Replace("register.html", Url.Action("Register", "Account"));
    html = html.Replace("reset-password.html", Url.Action("ResetPassword", "Account"));
}
@Html.Raw(html)
