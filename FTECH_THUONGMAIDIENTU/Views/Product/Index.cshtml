@using FTECH_THUONGMAIDIENTU.Models.Posts
@{
    Layout = null;
    var featuredPost = ViewBag.FeaturedPost as PostSummary;
}
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FTECH - @(featuredPost?.Title ?? "Chi tiết bài review sản phẩm")</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&amp;display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href='@Url.Content("~/Content/css/common/base.css")'>
    <link rel="stylesheet" href='@Url.Content("~/Content/css/common/layout.css")'>
    <link rel="stylesheet" href='@Url.Content("~/Content/css/pages/product.css")'>
    <link rel="stylesheet" href='@Url.Content("~/Content/css/common/inline-utilities.css")'>
</head>

<body>
    <div data-include='@Url.Content("~/components/header.html")'></div>

    <div class="breadcrumb">
        <a href='@Url.Action("Index", "Home")'>Trang chủ</a><span>›</span>
        <a href='@Url.Action("Index", "Home")#s-blog'>Tin tức &amp; đánh giá</a><span>›</span>
        <span>@(featuredPost?.Title ?? "Đánh giá nổi bật")</span>
    </div>

    <div class="wrap">
        <div class="card"
             style="padding: 28px; display: grid; gap: 24px; grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr); align-items: start;">
            <div>
                <div
                    style="color: #6b7280; font-size: 13px; text-transform: uppercase; letter-spacing: .14em; margin-bottom: 10px;">
                    Bài review nổi bật</div>
                    <h1 style="font-size: clamp(30px, 4vw, 52px); line-height: 1.05; margin: 0 0 16px;">
                        @(featuredPost?.Title ?? "Chưa có bài nổi bật")</h1>
                        <p style="margin: 0 0 18px; color: #4b5563; font-size: 16px; line-height: 1.8;">
                            @(featuredPost != null
                                ? $"Danh mục {featuredPost.CategoryName}, đăng ngày {featuredPost.CreatedAt:dd/MM/yyyy} và đang có               {featuredPost.ViewCount:N0} lượt xem."
                                : "Hệ thống chưa có bài review đã xuất bản để hiển thị.")
                        </p>
                        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                            <span class="badge">@((featuredPost?.CategoryName) ?? "Review")</span>
                            <span class="badge">@(featuredPost?.ViewCount.ToString("N0") ?? "0") lượt xem</span>
                            <span class="badge">@(featuredPost?.CreatedAt.ToString("dd/MM/yyyy") ?? "--/--/----")</span>
                        </div>
                    </div>
                    <div>
                        <div
                            style="border-radius: 22px; overflow: hidden; background: linear-gradient(135deg, #e9eef7, #f8fafc); min-height: 320px; display: flex; align-items: center; justify-content: center;">
                            @if (!string.IsNullOrWhiteSpace(featuredPost?.ThumbnailURL))
                            {
                                <img src="@featuredPost.ThumbnailURL" alt="@featuredPost.Title"
                                     style="width: 100%; height: 100%; object-fit: cover;">
                            }
                            else
                            {
                                <div style="padding: 32px; text-align: center; color: #6b7280; font-weight: 600;">Chưa có ảnh đại
                                    diện</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div data-include='@Url.Content("~/components/footer.html")'></div>
                <script src='@Url.Content("~/Scripts/js/common/include.js")'></script>
                <script src='@Url.Content("~/Scripts/js/pages/product.js")'></script>
            </body>

        </html>
