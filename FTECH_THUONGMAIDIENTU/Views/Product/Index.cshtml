@{
    Layout = null;
    var html = System.IO.File.ReadAllText(Server.MapPath("~/Views/product.html"));
    html = html.Replace("href=\"assets/css/common/base.css\"", "href=\"" + Url.Content("~/Content/css/common/base.css") +
"\"");
    html = html.Replace("href=\"assets/css/common/layout.css\"", "href=\"" + Url.Content("~/Content/css/common/layout.css")
+ "\"");
    html = html.Replace("href=\"assets/css/pages/product.css\"", "href=\"" + Url.Content("~/Content/css/pages/product.css")
+ "\"");
    html = html.Replace("href=\"assets/css/common/inline-utilities.css\"", "href=\"" +
Url.Content("~/Content/css/common/inline-utilities.css") + "\"");
    html = html.Replace("src=\"assets/js/common/include.js\"", "src=\"" + Url.Content("~/Scripts/js/common/include.js") +
"\"");
    html = html.Replace("src=\"assets/js/pages/product.js\"", "src=\"" + Url.Content("~/Scripts/js/pages/product.js") +
"\"");
    html = html.Replace("data-include=\"components/header.html\"", "data-include=\"" +
Url.Content("~/components/header.html") + "\"");
    html = html.Replace("data-include=\"components/footer.html\"", "data-include=\"" +
Url.Content("~/components/footer.html") + "\"");
    html = html.Replace("trangchu.html", Url.Action("Index", "Home"));
    html = html.Replace("reviewModule.html", Url.Action("Index", "Review"));
}
@Html.Raw(html)
