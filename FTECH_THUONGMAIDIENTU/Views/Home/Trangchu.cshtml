@{
    Layout = null;
    var html = System.IO.File.ReadAllText(Server.MapPath("~/Views/trangchu.html"));
    html = html.Replace("href=\"assets/css/pages/trangchu.css\"", "href=\"" +
Url.Content("~/Content/css/pages/trangchu.css") + "\"");
    html = html.Replace("href=\"assets/css/common/inline-utilities.css\"", "href=\"" +
Url.Content("~/Content/css/common/inline-utilities.css") + "\"");
    html = html.Replace("src=\"assets/js/common/include.js\"", "src=\"" + Url.Content("~/Scripts/js/common/include.js") +
"\"");
    html = html.Replace("src=\"assets/js/pages/trangchu.js\"", "src=\"" + Url.Content("~/Scripts/js/pages/trangchu.js") +
"\"");
    html = html.Replace("trangchu.html", Url.Action("Index", "Home"));
    html = html.Replace("login.html", Url.Action("Login", "Account"));
    html = html.Replace("register.html", Url.Action("Register", "Account"));
    html = html.Replace("product.html", Url.Action("Index", "Product"));
    html = html.Replace("reviewModule.html", Url.Action("Index", "Review"));
}
@Html.Raw(html)
