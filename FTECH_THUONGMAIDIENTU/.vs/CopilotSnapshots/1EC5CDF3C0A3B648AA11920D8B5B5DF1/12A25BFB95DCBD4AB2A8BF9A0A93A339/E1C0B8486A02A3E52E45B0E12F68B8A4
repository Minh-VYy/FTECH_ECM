@{
    ViewBag.Title = "Liên hệ";
}

<main class="mt-5">
    <div class="row">
        <div class="col-md-12">
            <h2>@ViewBag.Title</h2>
            <p class="text-muted">@ViewBag.Message</p>
            <hr />
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <h4>Thông tin liên hệ</h4>
            
            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="card-title">📍 Địa chỉ chính</h6>
                    <p class="card-text">
                        F-TECH Thương Mại Điện Tử<br />
                        Tòa nhà TechHub, 123 Đường Lê Lợi<br />
                        Quận 1, TP. Hồ Chí Minh, Việt Nam
                    </p>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="card-title">☎️ Hỗ trợ khách hàng</h6>
                    <p class="card-text">
                        <strong>Điện thoại:</strong> +84 (0)28 1234 5678<br />
                        <strong>Hotline:</strong> 1900 1234<br />
                        <strong>Giờ làm việc:</strong> Thứ 2 - Thứ 6, 8:00 - 18:00
                    </p>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h6 class="card-title">📧 Email</h6>
                    <p class="card-text">
                        <strong>Hỗ trợ chung:</strong> <a href="mailto:support@ftech.vn">support@ftech.vn</a><br />
                        <strong>Phòng kinh doanh:</strong> <a href="mailto:sales@ftech.vn">sales@ftech.vn</a><br />
                        <strong>Hỗ trợ kỹ thuật:</strong> <a href="mailto:tech@ftech.vn">tech@ftech.vn</a>
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <h4>Gửi tin nhắn cho chúng tôi</h4>
            
            <form method="post" action="~/Home/SendContact" class="needs-validation">
                <div class="mb-3">
                    <label for="fullName" class="form-label">Họ và tên <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="fullName" name="fullName" required 
                           placeholder="Nhập họ và tên của bạn">
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label">Email <span class="text-danger">*</span></label>
                    <input type="email" class="form-control" id="email" name="email" required 
                           placeholder="Nhập email của bạn">
                </div>

                <div class="mb-3">
                    <label for="phone" class="form-label">Điện thoại <span class="text-danger">*</span></label>
                    <input type="tel" class="form-control" id="phone" name="phone" required 
                           placeholder="Nhập số điện thoại">
                </div>

                <div class="mb-3">
                    <label for="subject" class="form-label">Tiêu đề <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="subject" name="subject" required 
                           placeholder="Nhập tiêu đề">
                </div>

                <div class="mb-3">
                    <label for="message" class="form-label">Nội dung <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="message" name="message" rows="5" required 
                              placeholder="Nhập nội dung tin nhắn của bạn"></textarea>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-send"></i> Gửi tin nhắn
                </button>
            </form>

            <div class="alert alert-info mt-3">
                <strong>💡 Gợi ý:</strong> Chúng tôi sẽ phản hồi trong vòng 24 giờ làm việc.
            </div>
        </div>
    </div>
</main>

@section scripts {
    <script>
        // Bootstrap form validation
        (function () {
            'use strict';
            window.addEventListener('load', function () {
                var forms = document.querySelectorAll('.needs-validation');
                var validation = Array.prototype.filter.call(forms, function (form) {
                    form.addEventListener('submit', function (event) {
                        if (form.checkValidity() === false) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            }, false);
        })();
    </script>
}