@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - FTECH User Account</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="@Url.Content("~/Content/css/pages/dashboard.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/css/pages/profileManager.css")">
</head>

<body>
    <div class="sidebar">
        <div class="sb-logo">
            <a href="@Url.Action("Dashboard", "Account", new { area = "UserAccount" })" class="logo">
                <span class="logo-badge">F</span>FTECH Account
            </a>
        </div>
        <div class="sb-label">User Account</div>
        <nav class="sb-menu">
            <a href="@Url.Action("Dashboard", "Account", new { area = "UserAccount" })" class="sb-item">
                <span class="si">👤</span>Trang Cá Nhân
            </a>
            <a href="@Url.Action("Profile", "Account", new { area = "UserAccount" })" class="sb-item">
                <span class="si">⚙️</span>Quản Lý Thông Tin
            </a>
            <a href="@Url.Action("Edit", "Account", new { area = "UserAccount" })" class="sb-item">
                <span class="si">✏️</span>Chỉnh Sửa Hồ Sơ
            </a>
            <a href="@Url.Action("Logout", "Account", new { area = "" })" data-logout="true" class="sb-item">
                <span class="si">🚪</span>Đăng Xuất
            </a>
        </nav>
        <div class="sb-bottom">
            <div class="sb-user">
                <div class="sb-avatar"><img src="@(ViewBag.UserAvatar ?? "https://i.pravatar.cc/120?img=20")"
                                                alt="User"></div>
                    <div>
                        <div class="sb-user-name">@(ViewBag.UserName ?? "User Account")</div>
                        <div class="sb-user-role">@(ViewBag.UserRole ?? "Khách Hàng")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="main">
            @RenderBody()
        </div>

        @Scripts.Render("~/bundles/jquery")
        @Scripts.Render("~/bundles/bootstrap")
        @RenderSection("scripts", required: false)
    </body>

</html>
