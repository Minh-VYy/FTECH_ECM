@{
    Layout = null;
    var currentAction = (ViewContext.RouteData.Values["action"] ?? "").ToString();
    Func<string, string> activeClass = action =>
        string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)
        || (string.Equals(currentAction, "Profile", StringComparison.OrdinalIgnoreCase) && string.Equals(action, "Dashboard", StringComparison.OrdinalIgnoreCase))
            ? " active"
            : "";
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - FTECH User Account</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="@Url.Content("~/Content/css/pages/dashboard.css?v=useraccount-20260602-2")">
</head>

<body>
    <div class="sidebar">
        <div class="sb-logo">
            <a href="@Url.Action("Dashboard", "Account", new { area = "UserAccount" })" class="logo">
                <span class="logo-badge">F</span>FTECH Account
            </a>
        </div>
        <div class="sb-label">User Account</div>
        <nav class="sb-menu">
            <a href="@Url.Action("Dashboard", "Account", new { area = "UserAccount" })" class="sb-item @activeClass("Dashboard")">
                Tổng Quan
            </a>
            <a href="@Url.Action("Edit", "Account", new { area = "UserAccount" })" class="sb-item @activeClass("Edit")">
                Cập Nhật Hồ Sơ
            </a>
            <a href="@Url.Action("Logout", "Account", new { area = "" })" data-logout="true" class="sb-item">
                Đăng Xuất
            </a>
        </nav>
        <div class="sb-bottom">
            <div class="sb-user">
                <div class="sb-avatar">
                    @{
                        var initial = "U";
                        var uName = ViewBag.UserName as string;
                        if (!string.IsNullOrWhiteSpace(uName)) {
                            initial = uName.Substring(0, 1).ToUpperInvariant();
                        }
                    }
                    <span class="sb-avatar-initial">@initial</span>
                    @if (ViewBag.UserAvatar != null && !string.IsNullOrWhiteSpace(ViewBag.UserAvatar.ToString())) {
                        <img src="@ViewBag.UserAvatar" alt="User" onerror="this.style.display='none';">
                    } else {
                        <img src="https://i.pravatar.cc/120?img=20" alt="User" onerror="this.style.display='none';">
                    }
                </div>
                <div>
                    <div class="sb-user-name">@(ViewBag.UserName ?? "User Account")</div>
                    <div class="sb-user-role">@(ViewBag.UserRole ?? "Khách Hàng")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="main">
        @RenderBody()
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>

</html>
