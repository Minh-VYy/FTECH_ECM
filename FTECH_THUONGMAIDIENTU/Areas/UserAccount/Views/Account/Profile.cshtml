@model FTECH_THUONGMAIDIENTU.Models.UserAccount.MemberProfileSummary
@{
    ViewBag.Title = "Thong Tin Ca Nhan";
    Layout = "~/Areas/UserAccount/Views/Shared/_UserAccountLayout.cshtml";
    var displayName = string.IsNullOrWhiteSpace(Model.FullName) ? "User" : Model.FullName.Trim();
    var avatarInitial = displayName.Substring(0, 1).ToUpperInvariant();
}

<div class="topbar">
    <div>
        <div class="topbar-title">T&#7893;ng quan t&#224;i kho&#7843;n</div>
        <div class="topbar-sub">H&#7891; s&#417;, tr&#7841;ng th&#225;i v&#224; ho&#7841;t &#273;&#7897;ng c&#7911;a b&#7841;n</div>
    </div>
    <div class="topbar-actions">
        <button class="btn-primary"
                onclick="location.href='@Url.Action("Edit", "Account", new { area = "UserAccount" })'">C&#7853;p nh&#7853;t h&#7891; s&#417;</button>
    </div>
</div>

<div class="content">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="account-alert">@TempData["SuccessMessage"]</div>
    }

    <section class="account-hero">
        <div class="account-identity">
            <div class="account-avatar-wrap">
                <span>@avatarInitial</span>
                <img src="@(Model.AvatarURL ?? "https://i.pravatar.cc/150?img=20")" alt="@displayName" onerror="this.style.display='none';">
            </div>
            <div>
                <div class="account-eyebrow">T&#224;i kho&#7843;n kh&#225;ch h&#224;ng</div>
                <h1>@displayName</h1>
                <div class="account-meta">@Model.Email</div>
                <div class="account-tags">
                    <span class="account-tag">Kh&#225;ch H&#224;ng</span>
                    <span class="account-tag is-muted">@Model.Status</span>
                </div>
            </div>
        </div>
        <div class="account-joined">
            <span>Ng&#224;y tham gia</span>
            <strong>@Model.CreatedAt.ToString("dd/MM/yyyy")</strong>
        </div>
    </section>

    <section class="account-grid">
        <div class="kpi-card kc-blue">
            <div class="kpi-label">Affiliate</div>
            <div class="kpi-val">@Model.ClickCount</div>
            <div class="kpi-sub">L&#432;&#7907;t click &#273;&#227; ghi nh&#7853;n</div>
        </div>
        <div class="kpi-card kc-green">
            <div class="kpi-label">B&#236;nh lu&#7853;n</div>
            <div class="kpi-val">@Model.CommentCount</div>
            <div class="kpi-sub">B&#236;nh lu&#7853;n &#273;&#227; g&#7917;i</div>
        </div>
        <div class="kpi-card kc-orange">
            <div class="kpi-label">&#272;&#225;nh gi&#225;</div>
            <div class="kpi-val">@Model.RatingCount</div>
            <div class="kpi-sub">&#272;&#225;nh gi&#225; s&#7843;n ph&#7849;m</div>
        </div>
    </section>

    <section class="card account-details">
        <div>
            <div class="card-title">Th&#244;ng tin h&#7891; s&#417;</div>
            <div class="card-sub">Th&#244;ng tin c&#417; b&#7843;n c&#7911;a t&#224;i kho&#7843;n kh&#225;ch h&#224;ng.</div>
        </div>
        <div class="detail-list">
            <div class="detail-row"><span>H&#7885; v&#224; t&#234;n</span><strong>@displayName</strong></div>
            <div class="detail-row"><span>Email</span><strong>@Model.Email</strong></div>
            <div class="detail-row"><span>Ng&#224;y tham gia</span><strong>@Model.CreatedAt.ToString("dd/MM/yyyy")</strong></div>
            <div class="detail-row"><span>Vai tr&#242;</span><strong>Kh&#225;ch H&#224;ng</strong></div>
            <div class="detail-row"><span>Tr&#7841;ng th&#225;i</span><strong>@Model.Status</strong></div>
        </div>
    </section>
</div>
