@model FTECH_THUONGMAIDIENTU.Models.UserAccount.MemberProfileSummary
@{
    ViewBag.Title = "Cap Nhat Ho So";
    Layout = "~/Areas/UserAccount/Views/Shared/_UserAccountLayout.cshtml";
}

<div class="topbar">
    <div>
        <div class="topbar-title">C&#7853;p nh&#7853;t h&#7891; s&#417;</div>
        <div class="topbar-sub">Ch&#7881;nh s&#7917;a t&#234;n hi&#7875;n th&#7883; v&#224; &#7843;nh &#273;&#7841;i di&#7879;n</div>
    </div>
</div>

<div class="content">
    <div class="card account-form-card">
        <div class="card-title">Th&#244;ng tin c&#225; nh&#226;n</div>
        <div class="card-sub">Email v&#224; tr&#7841;ng th&#225;i &#273;&#432;&#7907;c qu&#7843;n l&#253; b&#7903;i h&#7879; th&#7889;ng.</div>

        @using (Html.BeginForm("Edit", "Account", new { area = "UserAccount" }, FormMethod.Post))
        {
            <div class="account-form">
                <input type="hidden" name="Email" value="@Model.Email">
                <div class="field">
                    <label>H&#7885; v&#224; t&#234;n</label>
                    <input type="text" name="FullName" value="@Model.FullName">
                </div>

                <div class="field">
                    <label>Email</label>
                    <input type="email" name="EmailDisplay" value="@Model.Email" readonly>
                </div>

                <div class="field">
                    <label>&#7842;nh &#273;&#7841;i di&#7879;n</label>
                    <input type="text" name="AvatarURL" value="@Model.AvatarURL" placeholder="https://...">
                </div>

                <div class="field">
                    <label>Tr&#7841;ng th&#225;i</label>
                    <input type="text" value="@Model.Status" readonly>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn-ghost" onclick="location.href='@Url.Action("Dashboard", "Account", new { area = "UserAccount" })'">H&#7911;y</button>
                    <button type="submit" class="btn-primary">L&#432;u thay &#273;&#7893;i</button>
                </div>
            </div>
        }
    </div>
</div>

@section scripts {
    <script src="~/Scripts/js/common/auth.js"></script>
}
