@model FTECH_THUONGMAIDIENTU.Models.UserAccount.MemberProfileSummary
@{
    ViewBag.Title = "Quản Lý Thông Tin Cá Nhân";
    Layout = "~/Areas/UserAccount/Views/Shared/_UserAccountLayout.cshtml";
}

<div class="topbar">
    <div class="topbar-title">Chỉnh Sửa Thông Tin</div>
</div>

<div class="content">
    <div class="card" style="max-width: 600px;">
        <div class="card-title">Cập Nhật Thông Tin Cá Nhân</div>

        @using (Html.BeginForm("Edit", "Account", new { area = "UserAccount" }, FormMethod.Post))
        {
            <div style="padding: 20px;">
                <input type="hidden" name="Email" value="@Model.Email">
                <div style="margin-bottom: 15px;">
                    <label style="display: block; margin-bottom: 5px; font-weight: 600;">Họ và tên</label>
                    <input type="text" name="FullName" value="@Model.FullName"
                           style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px;">
                </div>

                <div style="margin-bottom: 15px;">
                    <label style="display: block; margin-bottom: 5px; font-weight: 600;">Email</label>
                    <input type="email" name="EmailDisplay" value="@Model.Email" readonly
                           style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; background: #f8f9fa;">
                </div>

                <div style="margin-bottom: 15px;">
                    <label style="display: block; margin-bottom: 5px; font-weight: 600;">Ảnh đại diện</label>
                    <input type="text" name="AvatarURL" value="@Model.AvatarURL"
                           style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px;">
                </div>

                <div style="margin-bottom: 15px;">
                    <label style="display: block; margin-bottom: 5px; font-weight: 600;">Trạng thái</label>
                    <input type="text" value="@Model.Status" readonly
                           style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; background: #f8f9fa;">
                </div>

                <div style="display: flex; gap: 10px;">
                    <button type="submit" class="btn-primary">💾 Lưu Thay Đổi</button>
                    <button type="button" class="btn-ghost" onclick="history.back()">❌ Hủy</button>
                </div>
            </div>
        }
    </div>
</div>

@section scripts {
    <script src="~/Scripts/js/common/auth.js"></script>
}
