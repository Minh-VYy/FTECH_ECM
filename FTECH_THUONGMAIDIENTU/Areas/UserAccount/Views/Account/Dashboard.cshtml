@{
    ViewBag.Title = "Trang Cá Nhân";
    Layout = "~/Areas/UserAccount/Views/Shared/_UserAccountLayout.cshtml";
}

<div class="topbar">
    <div class="topbar-title">Trang Cá Nhân Của Tôi</div>
    <div class="topbar-actions">
        <button class="btn-primary" onclick="location.href='@Url.Action("Edit", "Account", new { area = "UserAccount" })'">✏️ Chỉnh Sửa</button>
    </div>
</div>

<div class="content">
    <div class="card">
        <div class="card-title">Thông Tin Cá Nhân</div>
        
        <div style="padding: 20px;">
            <div style="display: flex; gap: 20px; margin-bottom: 20px;">
                <img src="https://i.pravatar.cc/150?img=20" alt="User" style="width: 150px; height: 150px; border-radius: 50%;">
                <div>
                    <h3>Tên Người Dùng</h3>
                    <p>Email: user@example.com</p>
                    <p>Tham gia: 01/01/2026</p>
                    <p><strong>Vai Trò:</strong> Khách Hàng</p>
                </div>
            </div>

            <div style="border-top: 1px solid #eee; padding-top: 20px;">
                <h4>Thống Kê</h4>
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px;">
                    <div style="background: #f8f9fa; padding: 15px; border-radius: 8px; text-align: center;">
                        <div style="font-size: 24px; font-weight: bold; color: #3498db;">12</div>
                        <div style="font-size: 12px; color: #7f8c8d;">Bài Viết Đã Xem</div>
                    </div>
                    <div style="background: #f8f9fa; padding: 15px; border-radius: 8px; text-align: center;">
                        <div style="font-size: 24px; font-weight: bold; color: #27ae60;">48</div>
                        <div style="font-size: 12px; color: #7f8c8d;">Sản Phẩm Đã Click</div>
                    </div>
                    <div style="background: #f8f9fa; padding: 15px; border-radius: 8px; text-align: center;">
                        <div style="font-size: 24px; font-weight: bold; color: #e74c3c;">5</div>
                        <div style="font-size: 12px; color: #7f8c8d;">Lần Mua Hàng</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/js/common/auth.js"></script>
}
