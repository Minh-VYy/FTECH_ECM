@{
    ViewBag.Title = "Bài Viết Của Tôi";
    Layout = "~/Areas/ContentManager/Views/Shared/_ContentManagerLayout.cshtml";
}

<div class="topbar">
    <div class="topbar-title">@ViewBag.Title</div>
    <div class="topbar-search">
        <input type="text" placeholder="Tìm tiêu đề, danh mục, từ khóa..." />
        <button>🔍</button>
    </div>
    <div class="u-style-001">
        <button class="btn-ghost" type="button">Xuất CSV</button>
        <button class="btn-primary" type="button" onclick="window.location='@Url.Action("Create", "Post", new { area = "ContentManager" })'">✏️ Tạo bài mới</button>
    </div>
</div>

<div class="content">

    <!-- STAT CARDS -->
    <div class="stat-row">
        <div class="stat-card sc-all">
            <div class="stat-label">Tất cả bài</div>
            <div class="stat-val sv-all">12</div>
            <div class="stat-sub">Toàn bộ bài viết của tôi</div>
        </div>
        <div class="stat-card sc-draft">
            <div class="stat-label">Bản nháp</div>
            <div class="stat-val sv-draft">3</div>
            <div class="stat-sub">Chưa gửi lên duyệt</div>
        </div>
        <div class="stat-card sc-pending">
            <div class="stat-label">Đang chờ duyệt</div>
            <div class="stat-val sv-pending">2</div>
            <div class="stat-sub">Đang chờ Super Admin xét duyệt</div>
        </div>
        <div class="stat-card sc-approved">
            <div class="stat-label">Đã duyệt</div>
            <div class="stat-val sv-approved">6</div>
            <div class="stat-sub">Đang hiển thị công khai</div>
        </div>
        <div class="stat-card sc-rejected">
            <div class="stat-label">Bị từ chối</div>
            <div class="stat-val sv-rejected">1</div>
            <div class="stat-sub">Cần chỉnh sửa và gửi lại</div>
        </div>
    </div>

    <!-- FILTER CHIPS -->
    <div class="filter-wrap">
        <button class="fchip active" type="button" onclick="setChip(this,'all')">Tất cả (12)</button>
        <button class="fchip fc-draft" type="button" onclick="setChip(this,'draft')">Nháp (3)</button>
        <button class="fchip fc-pending" type="button" onclick="setChip(this,'pending')">Chờ duyệt (2)</button>
        <button class="fchip fc-approved" type="button" onclick="setChip(this,'approved')">Đã duyệt (6)</button>
        <button class="fchip fc-rejected" type="button" onclick="setChip(this,'rejected')">Từ chối (1)</button>
        <select class="fsel u-style-002">
            <option>Tất cả danh mục</option>
            <option>Review</option><option>So sánh</option><option>Top list</option><option>Hướng dẫn</option>
        </select>
        <select class="fsel">
            <option>Mới cập nhật</option><option>Cũ nhất</option><option>A–Z</option>
        </select>
    </div>

    <!-- BULK BAR -->
    <div class="bulk-bar" id="bulkBar">
        <span class="bulk-info" id="bulkInfo">0 bài được chọn</span>
        <button class="btn-ghost u-style-003" type="button">Gửi duyệt hàng loạt</button>
        <button class="btn-ghost u-style-004" type="button">Xóa hàng loạt</button>
        <button class="btn-ghost u-style-005" type="button" onclick="clearSel()">Bỏ chọn</button>
    </div>

    <!-- TABLE -->
    <div class="table-wrap">
        <div class="t-head">
            <div><input type="checkbox" id="ckAll" onchange="toggleAll(this)"></div>
            <div class="th">Bài viết</div>
            <div class="th">Danh mục</div>
            <div class="th">Trạng thái</div>
            <div class="th">Lượt xem</div>
            <div class="th">Cập nhật</div>
            <div class="th">Thao tác</div>
        </div>

        <!-- APPROVED ROWS -->
        <div class="t-row" data-status="approved">
            <div><input type="checkbox" class="rck" onchange="updBulk()"></div>
            <div class="post-cell">
                <div class="post-thumb"><img src="https://images.unsplash.com/photo-1695048133142-1a20484d2569?auto=format&fit=crop&w=300&q=80" alt=""></div>
                <div>
                    <div class="post-title">Review iPhone 16 Pro Max: Đáng mua không năm 2026?</div>
                    <div class="post-meta">Bài đã xuất bản · 3 affiliate links · 7 phút đọc</div>
                </div>
            </div>
            <div><span class="cat-tag">Review</span></div>
            <div><span class="sp sp-approved">✓ Đã duyệt</span></div>
            <div class="metric">12.4K</div>
            <div class="u-style-006">14/03/2026</div>
            <div class="row-acts">
                <button class="act" type="button" onclick="openPreview('Review iPhone 16 Pro Max: Đáng mua không năm 2026?','approved','Review')" title="Xem trước">👁️</button>
                <button class="act act-edit" type="button" onclick="openEdit('Review iPhone 16 Pro Max: Đáng mua không năm 2026?','approved','Review')" title="Chỉnh sửa">✏️</button>
                <button class="act act-del" type="button" onclick="openDelete('Review iPhone 16 Pro Max: Đáng mua không năm 2026?')" title="Xóa">🗑️</button>
            </div>
        </div>

        <div class="t-row" data-status="approved">
            <div><input type="checkbox" class="rck" onchange="updBulk()"></div>
            <div class="post-cell">
                <div class="post-thumb"><img src="https://images.unsplash.com/photo-1546435770-a3e426bf472b?auto=format&fit=crop&w=300&q=80" alt=""></div>
                <div>
                    <div class="post-title">So sánh AirPods Pro 2 vs Sony WH-1000XM5: Chọn cái nào?</div>
                    <div class="post-meta">Bài đã xuất bản · 2 affiliate links · 5 phút đọc</div>
                </div>
            </div>
            <div><span class="cat-tag u-style-007">So sánh</span></div>
            <div><span class="sp sp-approved">✓ Đã duyệt</span></div>
            <div class="metric">8.1K</div>
            <div class="u-style-006">10/03/2026</div>
            <div class="row-acts">
                <button class="act" type="button" onclick="openPreview('So sánh AirPods Pro 2 vs Sony WH-1000XM5','approved','So sánh')" title="Xem trước">👁️</button>
                <button class="act act-edit" type="button" onclick="openEdit('So sánh AirPods Pro 2 vs Sony WH-1000XM5','approved','So sánh')" title="Chỉnh sửa">✏️</button>
                <button class="act act-del" type="button" onclick="openDelete('So sánh AirPods Pro 2 vs Sony WH-1000XM5')" title="Xóa">🗑️</button>
            </div>
        </div>

        <!-- PENDING ROWS -->
        <div class="t-row u-style-008" data-status="pending">
            <div><input type="checkbox" class="rck" onchange="updBulk()"></div>
            <div class="post-cell">
                <div class="post-thumb"><img src="https://images.unsplash.com/photo-1593642702821-c8da6771f0c6?auto=format&fit=crop&w=300&q=80" alt=""></div>
                <div>
                    <div class="post-title">Top 5 Laptop Gaming tầm trung tốt nhất 2026</div>
                    <div class="post-meta">Đang chờ Super Admin xét duyệt · 2 affiliate links</div>
                </div>
            </div>
            <div><span class="cat-tag u-style-009">Top list</span></div>
            <div><span class="sp sp-pending">⏳ Chờ duyệt</span></div>
            <div class="metric metric-m">—</div>
            <div class="u-style-006">18/03/2026</div>
            <div class="row-acts">
                <button class="act" type="button" onclick="openPreview('Top 5 Laptop Gaming tầm trung tốt nhất 2026','pending','Top list')" title="Xem trước">👁️</button>
                <button class="act act-edit u-style-010" type="button" onclick="openEdit('Top 5 Laptop Gaming tầm trung tốt nhất 2026','pending','Top list')" title="Xem / Sửa" disabled>✏️</button>
            </div>
        </div>

        <div class="t-row u-style-008" data-status="pending">
            <div><input type="checkbox" class="rck" onchange="updBulk()"></div>
            <div class="post-cell">
                <div class="post-thumb"><img src="https://images.unsplash.com/photo-1579586337278-3befd40fd17a?auto=format&fit=crop&w=300&q=80" alt=""></div>
                <div>
                    <div class="post-title">Apple Watch Series 10 — Có gì mới? Có nên nâng cấp không?</div>
                    <div class="post-meta">Đang chờ Super Admin xét duyệt · 1 affiliate link</div>
                </div>
            </div>
            <div><span class="cat-tag">Review</span></div>
            <div><span class="sp sp-pending">⏳ Chờ duyệt</span></div>
            <div class="metric metric-m">—</div>
            <div class="u-style-006">19/03/2026</div>
            <div class="row-acts">
                <button class="act" type="button" onclick="openPreview('Apple Watch Series 10 — Có gì mới?','pending','Review')" title="Xem trước">👁️</button>
            </div>
        </div>

        <!-- DRAFT ROWS -->
        <div class="t-row" data-status="draft">
            <div><input type="checkbox" class="rck" onchange="updBulk()"></div>
            <div class="post-cell">
                <div class="post-thumb u-style-011">📝</div>
                <div>
                    <div class="post-title">Hướng dẫn chọn tai nghe gaming 2026 — bản nháp</div>
                    <div class="post-meta">Bản nháp · Chưa gửi duyệt · Chưa có affiliate link</div>
                </div>
            </div>
            <div><span class="cat-tag u-style-012">Hướng dẫn</span></div>
            <div><span class="sp sp-draft">📝 Bản nháp</span></div>
            <div class="metric metric-m">—</div>
            <div class="u-style-006">21/03/2026</div>
            <div class="row-acts">
                <button class="act" type="button" onclick="openPreview('Hướng dẫn chọn tai nghe gaming 2026','draft','Hướng dẫn')" title="Xem trước">👁️</button>
                <button class="act act-edit" type="button" onclick="openEdit('Hướng dẫn chọn tai nghe gaming 2026','draft','Hướng dẫn')" title="Chỉnh sửa">✏️</button>
                <button class="act act-send" type="button" onclick="openSend('Hướng dẫn chọn tai nghe gaming 2026')" title="Gửi duyệt">📤</button>
                <button class="act act-del" type="button" onclick="openDelete('Hướng dẫn chọn tai nghe gaming 2026')" title="Xóa">🗑️</button>
            </div>
        </div>

        <div class="t-row" data-status="draft">
            <div><input type="checkbox" class="rck" onchange="updBulk()"></div>
            <div class="post-cell">
                <div class="post-thumb u-style-011">📝</div>
                <div>
                    <div class="post-title">MacBook Air M3 so với Dell XPS 13 — bản nháp</div>
                    <div class="post-meta">Bản nháp · Đã có 1 affiliate link · Cần bổ sung nội dung</div>
                </div>
            </div>
            <div><span class="cat-tag u-style-007">So sánh</span></div>
            <div><span class="sp sp-draft">📝 Bản nháp</span></div>
            <div class="metric metric-m">—</div>
            <div class="u-style-006">25/03/2026</div>
            <div class="row-acts">
                <button class="act" type="button" onclick="openPreview('MacBook Air M3 so với Dell XPS 13','draft','So sánh')" title="Xem trước">👁️</button>
                <button class="act act-edit" type="button" onclick="openEdit('MacBook Air M3 so với Dell XPS 13','draft','So sánh')" title="Chỉnh sửa">✏️</button>
                <button class="act act-send" type="button" onclick="openSend('MacBook Air M3 so với Dell XPS 13')" title="Gửi duyệt">📤</button>
                <button class="act act-del" type="button" onclick="openDelete('MacBook Air M3 so với Dell XPS 13')" title="Xóa">🗑️</button>
            </div>
        </div>

        <!-- REJECTED ROW -->
        <div class="t-row u-style-013" data-status="rejected">
            <div><input type="checkbox" class="rck" onchange="updBulk()"></div>
            <div class="post-cell">
                <div class="post-thumb"><img src="https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=300&q=80" alt=""></div>
                <div>
                    <div class="post-title">Gaming PC Build dưới 15 triệu — Cấu hình mạnh nhất 2026</div>
                    <div class="rejected-reason">⚠️ Lý do từ chối: nội dung chưa đầy đủ, thiếu affiliate link — cần chỉnh sửa và gửi lại</div>
                </div>
            </div>
            <div><span class="cat-tag u-style-009">Hướng dẫn</span></div>
            <div><span class="sp sp-rejected">✕ Từ chối</span></div>
            <div class="metric metric-m">—</div>
            <div class="u-style-006">17/03/2026</div>
            <div class="row-acts">
                <button class="act" type="button" onclick="openPreview('Gaming PC Build dưới 15 triệu','rejected','Hướng dẫn')" title="Xem trước">👁️</button>
                <button class="act act-edit" type="button" onclick="openEdit('Gaming PC Build dưới 15 triệu','rejected','Hướng dẫn')" title="Chỉnh sửa & gửi lại">✏️</button>
                <button class="act act-send" type="button" onclick="openSend('Gaming PC Build dưới 15 triệu')" title="Gửi duyệt lại">📤</button>
                <button class="act act-del" type="button" onclick="openDelete('Gaming PC Build dưới 15 triệu')" title="Xóa">🗑️</button>
            </div>
        </div>

        <!-- PAGINATION -->
        <div class="pagination">
            <div class="pag-info">Hiển thị 1–7 / 12 bài viết của bạn</div>
            <div class="pag-btns">
                <button class="pag-btn" type="button">‹</button>
                <button class="pag-btn active" type="button">1</button>
                <button class="pag-btn" type="button">2</button>
                <button class="pag-btn" type="button">›</button>
            </div>
        </div>
    </div><!-- /table-wrap -->

</div><!-- /content -->

<!-- MODALS (referenced via JavaScript) -->
<div class="modal-overlay" id="editModal"></div>
<div class="modal-overlay" id="sendModal"></div>
<div class="modal-overlay" id="deleteModal"></div>
<div class="modal-overlay" id="previewModal"></div>

@section scripts {
    <script src="~/Scripts/js/common/auth.js"></script>
    <script src="~/Scripts/js/pages/content-manager.js"></script>
}
