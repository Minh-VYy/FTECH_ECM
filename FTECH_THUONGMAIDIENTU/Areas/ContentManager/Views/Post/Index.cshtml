@model FTECH_THUONGMAIDIENTU.Models.ContentManager.PostListViewModel
@{
    Layout = "~/Areas/ContentManager/Views/Shared/_ContentManagerLayout.cshtml";
}

<div class="topbar">
    <div class="topbar-title">@Model.Title</div>
    <div class="topbar-search">
        <input type="text" placeholder="Tìm tiêu đề, danh mục, từ khóa..." />
        <button>🔍</button>
    </div>
    <div class="u-style-001">
        <button class="btn-ghost" type="button">Xuất CSV</button>
        <button class="btn-primary" type="button"
                onclick="window.location='@Url.Action("Create", "Post", new { area = "ContentManager" })'">✏️ Tạo bài
            mới</button>
        </div>
    </div>

    <div class="content">
        <div class="stat-row">
            <div class="stat-card sc-all">
                <div class="stat-label">Tất cả bài</div>
                <div class="stat-val sv-all">@Model.TotalPosts</div>
                <div class="stat-sub">Toàn bộ bài viết của tôi</div>
            </div>
            <div class="stat-card sc-draft">
                <div class="stat-label">Bản nháp</div>
                <div class="stat-val sv-draft">@Model.DraftCount</div>
                <div class="stat-sub">Chưa gửi lên duyệt</div>
            </div>
            <div class="stat-card sc-pending">
                <div class="stat-label">Đang chờ duyệt</div>
                <div class="stat-val sv-pending">@Model.PendingCount</div>
                <div class="stat-sub">Đang chờ Super Admin xét duyệt</div>
            </div>
            <div class="stat-card sc-approved">
                <div class="stat-label">Đã duyệt</div>
                <div class="stat-val sv-approved">@Model.ApprovedCount</div>
                <div class="stat-sub">Đang hiển thị công khai</div>
            </div>
            <div class="stat-card sc-rejected">
                <div class="stat-label">Bị từ chối</div>
                <div class="stat-val sv-rejected">@Model.RejectedCount</div>
                <div class="stat-sub">Cần chỉnh sửa và gửi lại</div>
            </div>
        </div>

        <div class="filter-wrap">
            <button class="fchip active" type="button" onclick="setChip(this,'all')">Tất cả (@Model.TotalPosts)</button>
            <button class="fchip fc-draft" type="button" onclick="setChip(this,'draft')">Nháp (@Model.DraftCount)</button>
            <button class="fchip fc-pending" type="button" onclick="setChip(this,'pending')">Chờ duyệt
                (@Model.PendingCount)</button>
                <button class="fchip fc-approved" type="button" onclick="setChip(this,'approved')">Đã duyệt
                    (@Model.ApprovedCount)</button>
                    <button class="fchip fc-rejected" type="button" onclick="setChip(this,'rejected')">Từ chối
                        (@Model.RejectedCount)</button>
                        <select class="fsel u-style-002">
                            <option>Tất cả danh mục</option>
                            <option>Review</option>
                            <option>So sánh</option>
                            <option>Top list</option>
                            <option>Hướng dẫn</option>
                        </select>
                        <select class="fsel">
                            <option>Mới cập nhật</option>
                            <option>Cũ nhất</option>
                            <option>A–Z</option>
                        </select>
                    </div>

                    <div class="bulk-bar" id="bulkBar">
                        <span class="bulk-info" id="bulkInfo">0 bài được chọn</span>
                        <button class="btn-ghost u-style-003" type="button">Gửi duyệt hàng loạt</button>
                        <button class="btn-ghost u-style-004" type="button">Xóa hàng loạt</button>
                        <button class="btn-ghost u-style-005" type="button" onclick="clearSel()">Bỏ chọn</button>
                    </div>

                    <div class="table-wrap">
                        <div class="t-head">
                            <div><input type="checkbox" id="ckAll" onchange="toggleAll(this)"></div>
                            <div class="th">Bài viết</div>
                            <div class="th">Danh mục</div>
                            <div class="th">Trạng thái</div>
                            <div class="th">Lượt xem</div>
                            <div class="th">Cập nhật</div>
                            <div class="th">Thao tác</div>
                        </div>

                        @Html.Raw(Model.PostRowsHtml)

                        <div class="pagination">
                            <div class="pag-info">Hiển thị 1–7 / @Model.TotalPosts bài viết của bạn</div>
                            <div class="pag-btns">
                                <button class="pag-btn" type="button">‹</button>
                                <button class="pag-btn active" type="button">1</button>
                                <button class="pag-btn" type="button">2</button>
                                <button class="pag-btn" type="button">›</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-overlay" id="editModal"></div>
                <div class="modal-overlay" id="sendModal"></div>
                <div class="modal-overlay" id="deleteModal"></div>
                <div class="modal-overlay" id="previewModal"></div>

                @section scripts {
                    <script src="~/Scripts/js/common/auth.js"></script>
                    <script src="~/Scripts/js/pages/content-manager.js"></script>
                }
