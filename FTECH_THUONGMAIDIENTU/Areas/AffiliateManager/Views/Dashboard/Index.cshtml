@using FTECH_THUONGMAIDIENTU.Models.Dashboard
@{
    ViewBag.Title = "Dashboard - Quản Lý Affiliate";
    Layout = "~/Areas/AffiliateManager/Views/Shared/_AffiliateManagerLayout.cshtml";
    var summary = ViewBag.Summary as DashboardSummary ?? new DashboardSummary();
}

<div class="topbar">
    <div class="topbar-title">Dashboard Affiliate</div>
    <div class="topbar-search"><input type="text" placeholder="Tìm affiliate, link..."><button>🔍</button></div>
    <div class="topbar-actions">
        <button class="btn-ghost">Xuất báo cáo</button>
        <button class="btn-primary">Làm mới</button>
    </div>
</div>

<div class="content">
    <div class="kpi-grid">
        <div class="kpi-card kc-blue">
            <div class="kpi-label">Tổng Click</div>
            <div class="kpi-val">@summary.ClickCount</div>
            <div class="kpi-trend">Dữ liệu trực tiếp từ DB</div>
            <div class="kpi-sub">Từ @summary.PartnerCount đối tác</div>
        </div>
        <div class="kpi-card kc-green">
            <div class="kpi-label">Conversion</div>
            <div class="kpi-val">@summary.RatingCount</div>
            <div class="kpi-trend">Số đánh giá ghi nhận</div>
            <div class="kpi-sub">Dùng để đối soát hiệu quả nội dung</div>
        </div>
        <div class="kpi-card kc-purple">
            <div class="kpi-label">Doanh Thu</div>
            <div class="kpi-val">@summary.PartnerCount</div>
            <div class="kpi-trend">Đối tác active trong tháng</div>
            <div class="kpi-sub">@summary.PublishedPostCount bài đã xuất bản</div>
        </div>
        <div class="kpi-card kc-orange">
            <div class="kpi-label">Top Partner</div>
            <div class="kpi-val">@summary.PartnerCount</div>
            <div class="kpi-trend">Đang theo dõi</div>
            <div class="kpi-sub">@summary.PendingPostCount bài chờ duyệt</div>
        </div>
    </div>

    <div class="section-head">
        <div class="sec-title">Affiliate Links Gần Đây</div>
    </div>

    <div class="table-wrap">
        <div class="t-head">
            <div class="th">Link</div>
            <div class="th">Click</div>
            <div class="th">Conversion</div>
            <div class="th">Doanh Thu</div>
            <div class="th">Tạo Lúc</div>
        </div>
        <div class="t-row">
            <div><strong>shopee.vn/product/iphone</strong></div>
            <div class="metric-g">4,820</div>
            <div class="metric-a">312</div>
            <div class="metric-p">6.2Mđ</div>
            <div>01/03/2026</div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/js/common/auth.js"></script>
    <script src="~/Scripts/js/pages/dashboard.js"></script>
}
