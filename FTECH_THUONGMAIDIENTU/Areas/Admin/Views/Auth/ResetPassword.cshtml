@{
    ViewBag.Title = "Đặt lại mật khẩu";
    ViewBag.AuthHeaderHint = "Đã nhớ mật khẩu ?";
    ViewBag.AuthCtaText = "Đăng nhập";
    ViewBag.AuthCtaUrl = Url.Action("Login", "Account", new { area = "Admin" });
    Layout = "~/Areas/Admin/Views/Shared/_AdminAuthLayout.cshtml";
}

<div class="shell">
    <section class="form-side">
        <div class="form-head">
            <div class="form-title">Đặt lại mật khẩu</div>
            <div class="form-sub">Điền email đã đăng ký để nhận liên kết đặt lại mật khẩu và tạo mật khẩu mới.</div>
        </div>

        <div class="progress">
            <div class="prog-item active" id="prog1">Bước 1: Nhập email</div>
            <div class="prog-item" id="prog2">Bước 2: Kiểm tra email</div>
            <div class="prog-item" id="prog3">Bước 3: Mật khẩu mới</div>
        </div>

        <div class="toast success" id="toastSuccess">Hệ thống đã gửi email chứa link đặt lại mật khẩu. Link có hiệu lực
            trong 15 phút.</div>
            <div class="toast error" id="toastError">Vui lòng kiểm tra lại thông tin bạn vừa nhập.</div>

            <div class="panel active" id="step1">
                <div class="field">
                    <label>Email đăng ký</label>
                    <input id="email" type="email" placeholder="example@email.com" />
                    <div class="helper">Nhập đúng email đã dùng để đăng ký tài khoản. Hệ thống sẽ gửi link đặt lại mật khẩu
                        có hiệu lực trong 15 phút.</div>
                    </div>
                    <div class="actions">
                        <a class="btn-ghost u-style-109" href="@Url.Action("Login", "Account", new { area = "Admin" })">Hủy</a>
                        <button class="btn-primary" type="button" onclick="goStep2()">Gửi link đặt lại mật khẩu</button>
                    </div>
                </div>

                <div class="panel" id="step2">
                    <div class="success-box u-style-110">
                        <strong>Kiểm tra email của bạn</strong>
                        <p id="sentEmailText">Chúng tôi đã gửi liên kết đặt lại mật khẩu đến email bạn vừa nhập.</p>
                    </div>
                    <div class="helper u-style-014">Vui lòng mở hộp thư đến hoặc thư mục Spam, sau đó nhấn vào liên kết trong
                        email để tiếp tục. Liên kết này có hiệu lực trong 15 phút.</div>
                        <div class="u-style-111">
                            <div class="u-style-112">Không nhận được email?</div>
                            <div class="u-style-113">Kiểm tra lại thư mục Spam hoặc chờ trong vài phút. Nếu vẫn chưa thấy email, bạn
                                có thể gửi lại yêu cầu khôi phục.</div>
                            </div>
                            <div class="actions">
                                <button class="btn-ghost" type="button" onclick="backStep1()">Nhập lại email</button>
                                <button class="btn-ghost" type="button" onclick="goStep2(true)">Gửi lại email</button>
                                <button class="btn-primary" type="button" onclick="goStep3()">Tiếp tục</button>
                            </div>
                        </div>

                        <div class="panel" id="step3">
                            <div class="field">
                                <label>Mật khẩu mới</label>
                                <input id="newPassword" type="password" placeholder="Tối thiểu 8 ký tự" />
                            </div>
                            <div class="field">
                                <label>Xác nhận mật khẩu mới</label>
                                <input id="confirmPassword" type="password" placeholder="Nhập lại mật khẩu mới" />
                            </div>
                            <div class="helper">Mật khẩu nên có ít nhất 8 ký tự và bao gồm chữ hoa, chữ thường, số hoặc ký tự đặc biệt
                                để tăng độ an toàn.</div>
                                <div class="actions">
                                    <button class="btn-ghost" type="button" onclick="backStep2()">Quay lại</button>
                                    <button class="btn-primary" type="button" onclick="submitReset()">Cập nhật mật khẩu</button>
                                </div>
                            </div>

                            <div class="panel" id="step4">
                                <div class="success-box">
                                    <strong>Mật khẩu đã được cập nhật thành công</strong>
                                    <p>Mật khẩu mới đã được lưu thành công. Bạn có thể quay lại trang đăng nhập và sử dụng mật khẩu vừa cập
                                        nhật.</p>
                                    </div>
                                    <div class="actions">
                                        <a class="btn-primary u-style-109" href="@Url.Action("Login", "Account", new { area = "Admin" })">Đăng
                                            nhập ngay</a>
                                        </div>
                                    </div>
                                </section>
                            </div>

                            @section scripts {
                                <script src="~/Scripts/js/pages/reset-password.js"></script>
                            }